{
  "name": "oos-pipeline-ts",
  "version": "1.0.0",
  "description": "Onisin Pipeline DSL \u2014 Langium grammar, AST types, runtime types, and validator for the .pipeline language",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types-only.ts",
    "./generated": "./src/generated/index.ts",
    "./services": "./src/services.ts",
    "./monarch/pipeline": "./src/syntaxes/onisin-pipeline.monarch.ts",
    "./textmate/pipeline": "./src/syntaxes/onisin-pipeline.tmLanguage.json"
  },
  "scripts": {
    "lang:generate": "langium generate",
    "check": "tsgo --noEmit"
  },
  "dependencies": {
    "langium": "^4.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "langium-cli": "^4.2.1",
    "typescript": "^5.7.2"
  }
}
