{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onisin OS - Operator",
  "version": "0.1.0",
  "identifier": "com.onisin.ooso",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Onisin OS - Operator",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
